# ══════════════════════════════════════════════════════════════════════
# RAMCES / SIMA-KAI — environment
# ══════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this example is not, so never put a real secret in here.
#
#     cp .env.example .env
#
# `database.py` and `main.py` both call load_dotenv(), so nothing else is
# needed to pick these up.


# ── REQUIRED ──────────────────────────────────────────────────────────

# Signs every login token. The app REFUSES TO BOOT without it, on purpose:
# a hardcoded fallback is published in the source, and anyone holding it can
# mint a SUPER_ADMIN token without ever calling /api/login.
#
# Generate a fresh one:
#     py -3.10 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL connection. Format:
#     postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:CHANGEME@localhost:PORT/DB_NAME


# ── OPTIONAL ──────────────────────────────────────────────────────────

# Password given to the bootstrap SUPER_ADMIN account that `seed.py` creates.
# Leave blank and the seeder generates a random one and prints it ONCE — there
# is no way to recover it afterwards except a reset by another SUPER_ADMIN.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# External base URL, used ONLY to build QR / landing links when the page is
# being viewed on localhost. See GET /api/config.
PUBLIC_URL=
